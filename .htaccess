# ============================================
# .HTACCESS - MINIMAL VERSION
# ============================================

RewriteEngine On

# --- Aturan untuk menghilangkan .php ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.php [L]

# --- Root / ke dashboard ---
RewriteRule ^$ dashboard.php [L]

# --- Nota digital ---
RewriteRule ^nota/([A-Z0-9]+)/?$ index.php?order=$1 [L]

# --- Redirect akses langsung dengan .php ---
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# --- Keamanan ---
Options -Indexes

# --- CSP Minimal ---
<IfModule mod_headers.c>
    Header set Content-Security-Policy-Report-Only "script-src 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://static.cloudflareinsights.com;"
</IfModule>
