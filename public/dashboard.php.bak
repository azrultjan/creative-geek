    <script>
        // ---------- CHAT WIDGET & NOTIFIKASI ----------
        let previousChatIds = [];

        function showToast(message, title = '💬 Pesan Baru') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.innerHTML = `
                <span class="icon">💬</span>
                <div class="msg"><strong>${title}</strong><br>${message}</div>
                <button class="close-toast" onclick="this.parentElement.remove()">✕</button>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                if (toast.parentElement) toast.remove();
            }, 5000);
        }

        async function loadChatWidget() {
            try {
                const res = await fetch('whatsapp_ajax.php?action=get_chats&limit=5');
                const data = await res.json();
                const container = document.getElementById('chatWidget');
                const badge = document.getElementById('chatBadge');
                if (data.success && data.data && data.data.length > 0) {
                    const currentIds = data.data.map(c => c.id).filter(id => id);
                    const newChats = currentIds.filter(id => !previousChatIds.includes(id));
                    
                    if (newChats.length > 0 && previousChatIds.length > 0) {
                        const newChatData = data.data.filter(c => newChats.includes(c.id));
                        newChatData.forEach(chat => {
                            const name = chat.name || chat.pushName || chat.id || 'Unknown';
                            const lastMsg = chat.lastMessage?.text || 'Pesan baru';
                            showToast(`Dari ${name}: ${lastMsg}`, '💬 Chat Baru');
                        });
                        try {
                            const audio = new Audio('data:audio/wav;base64,UklGRlQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQoAAACBhYqLh4eGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoaGhoY=');
                            audio.play().catch(() => {});
                        } catch(e) {}
                    }

                    const totalUnread = data.data.reduce((acc, chat) => acc + (chat.unreadCount || 0), 0);
                    if (totalUnread > 0) {
                        badge.style.display = 'inline';
                        badge.textContent = totalUnread;
                    } else {
                        badge.style.display = 'none';
                    }

                    let html = '';
                    data.data.slice(0, 5).forEach(chat => {
                        const name = chat.name || chat.pushName || chat.id || 'Unknown';
                        const lastMsg = chat.lastMessage?.text || 'Tidak ada pesan';
                        const unread = chat.unreadCount || 0;
                        html += `<div class="chat-item" onclick="window.location.href='whatsapp.php'">
                            <div class="flex justify-between">
                                <span class="font-semibold text-white text-sm">${name}</span>
                                ${unread > 0 ? `<span class="unread-badge">${unread}</span>` : ''}
                            </div>
                            <div class="text-xs text-gray-400 truncate">${lastMsg}</div>
                        </div>`;
                    });
                    container.innerHTML = html;
                    previousChatIds = currentIds;
                } else {
                    container.innerHTML = '<div class="text-center text-gray-500 py-4">📭 Belum ada chat</div>';
                    badge.style.display = 'none';
                }
            } catch (e) {
                document.getElementById('chatWidget').innerHTML = '<div class="text-center text-red-400 py-4">❌ Gagal memuat chat</div>';
            }
        }

        loadChatWidget();
        setInterval(loadChatWidget, 10000);

        if ('Notification' in window && Notification.permission === 'default') {
            Notification.requestPermission();
        }
    </script>
    <?php endif; ?>

    <?php if ($role === 'owner'): ?>
    <script>
        // ApexChart untuk owner
        const options = {
            series: [{ name: 'Pendapatan', data: [0,0,0,0,0,90000] }],
            chart: { type: 'bar', height: 260, toolbar: { show: false }, background: 'transparent' },
            plotOptions: { bar: { borderRadius: 6, columnWidth: '50%' } },
            dataLabels: { enabled: false },
            colors: ['#f5a623'],
            grid: { borderColor: '#1f1f1f', strokeDashArray: 4 },
            xaxis: { categories: ["Mar","Apr","May","Jun","Jul","Aug"], labels: { style: { colors: '#9ca3af', fontSize: '12px' } } },
            yaxis: { labels: { style: { colors: '#9ca3af', fontSize: '12px' }, formatter: v => 'Rp'+v.toLocaleString('id-ID') } },
            tooltip: { y: { formatter: v => 'Rp'+v.toLocaleString('id-ID') } }
        };
        new ApexCharts(document.querySelector("#revenueChart"), options).render();
    </script>
    <?php endif; ?>

    <script>
        function updateClock() {
            document.getElementById('clock').textContent = '🕐 ' + new Date().toTimeString().slice(0,8);
        }
        setInterval(updateClock, 1000);
    </script>
