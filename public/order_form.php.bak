<?php
require_once '../includes/auth.php';
requireLogin();
require_once '../config/database.php';
require_once '../includes/functions.php';

$id = $_GET['id'] ?? 0;
$is_edit = $id > 0;

$order = null;
$items = [];
if ($is_edit) {
    $stmt = $pdo->prepare("SELECT * FROM orders WHERE id = ?");
    $stmt->execute([$id]);
    $order = $stmt->fetch();
    if (!$order) die('Pesanan tidak ditemukan.');
    $stmt_items = $pdo->prepare("SELECT * FROM order_items WHERE order_id = ?");
    $stmt_items->execute([$id]);
    $items = $stmt_items->fetchAll();
}

$customers = $pdo->query("SELECT * FROM customers ORDER BY name")->fetchAll();

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $customer_id = $_POST['customer_id'] ?? '';
    if (empty($customer_id) || !is_numeric($customer_id)) {
        die('Error: Silakan pilih pelanggan yang valid.');
    }
    $customer_id = (int)$customer_id;
    $status = $_POST['status'] ?? 'diterima';
    $payment_status = $_POST['payment_status'] ?? 'belum';
    $payment_method = $_POST['payment_method'] ?? 'Cash';
    $subtotal = $_POST['subtotal'] ?? 0;
    $discount = $_POST['discount'] ?? 0;
    $grand_total = $_POST['grand_total'] ?? 0;
    $notes = $_POST['notes'] ?? '';

    $product_names = $_POST['product_name'] ?? [];
    $qtys = $_POST['qty'] ?? [];
    $prices = $_POST['price'] ?? [];
    $materials = $_POST['material'] ?? [];
    $item_notes = $_POST['item_notes'] ?? [];
    $totals = $_POST['item_total'] ?? [];

    if ($is_edit) {
        $pdo->prepare("UPDATE orders SET customer_id=?, status=?, payment_status=?, payment_method=?, subtotal=?, discount=?, grand_total=?, notes=? WHERE id=?")
            ->execute([$customer_id, $status, $payment_status, $payment_method, $subtotal, $discount, $grand_total, $notes, $id]);
        $pdo->prepare("DELETE FROM order_items WHERE order_id = ?")->execute([$id]);
    } else {
        $order_number = generateOrderNumber();
        $pdo->prepare("INSERT INTO orders (order_number, customer_id, status, payment_status, payment_method, subtotal, discount, grand_total, notes) VALUES (?,?,?,?,?,?,?,?,?)")
            ->execute([$order_number, $customer_id, $status, $payment_status, $payment_method, $subtotal, $discount, $grand_total, $notes]);
        $id = $pdo->lastInsertId();
    }

    for ($i = 0; $i < count($product_names); $i++) {
        if (!empty($product_names[$i])) {
            $pdo->prepare("INSERT INTO order_items (order_id, product_name, qty, price_per_unit, material, notes, total) VALUES (?,?,?,?,?,?,?)")
                ->execute([$id, $product_names[$i], $qtys[$i], $prices[$i], $materials[$i], $item_notes[$i], $totals[$i]]);
        }
    }

    // Kirim notifikasi WhatsApp jika pesanan baru
    if (!$is_edit) {
        $customer = $pdo->prepare("SELECT phone, name FROM customers WHERE id = ?")->execute([$customer_id]) ? $pdo->query("SELECT phone, name FROM customers WHERE id = $customer_id")->fetch() : null;
        if ($customer && !empty($customer['phone'])) {
            $customerName = $customer['name'] ?? 'Kak';
            $message = "Halo $customerName.\nBerikut kami kirim bukti transaksi percetakan melalui e-receipt:\nhttps://cloud.creativegeek-idn.com/index.php?order={$order_number}\nTerima kasih telah bertransaksi di Creative Geek =)";
            sendWhatsAppNotification($customer['phone'], $message);
        }
    }

    header('Location: orders.php?msg=updated');
    exit;
}
?>
