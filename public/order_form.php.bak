    <!-- Template item -->
    <div id="item-template" style="display: none;">
        <?php include '_item_template.php'; ?>
    </div>

    <script>
        // ============== CUSTOMER SEARCH ==============
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('customer_search');
            const hiddenId = document.getElementById('customer_id');
            const datalist = document.getElementById('customer_list');
            const errorDiv = document.getElementById('customer_error');

            const allCustomers = <?= json_encode(array_map(function($c) {
                return ['id' => $c['id'], 'name' => $c['name']];
            }, $customers)) ?>;

            function updateDatalist(query) {
                const trimmed = query.trim();
                let filtered = allCustomers.filter(c => 
                    c.name.toLowerCase().includes(trimmed.toLowerCase())
                );
                filtered = filtered.slice(0, 5);
                datalist.innerHTML = '';
                if (filtered.length === 0) {
                    const opt = document.createElement('option');
                    opt.value = 'Tidak ditemukan';
                    datalist.appendChild(opt);
                } else {
                    filtered.forEach(c => {
                        const option = document.createElement('option');
                        option.value = c.name;
                        option.dataset.id = c.id;
                        datalist.appendChild(option);
                    });
                }
                updateHiddenId();
            }

            function updateHiddenId() {
                const val = searchInput.value.trim();
                const matched = allCustomers.find(c => c.name === val);
                if (matched) {
                    hiddenId.value = matched.id;
                    errorDiv.classList.add('hidden');
                } else {
                    hiddenId.value = '';
                    if (val !== '' && val !== 'Tidak ditemukan') {
                        errorDiv.classList.remove('hidden');
                    } else {
                        errorDiv.classList.add('hidden');
                    }
                }
            }

            searchInput.addEventListener('input', function() { updateDatalist(this.value); });
            searchInput.addEventListener('change', function() { updateHiddenId(); });
            updateDatalist('');

            <?php if ($is_edit && $order): ?>
                const customerName = <?= json_encode($order['customer_name'] ?? '') ?>;
                if (customerName) {
                    searchInput.value = customerName;
                    hiddenId.value = <?= $order['customer_id'] ?>;
                    errorDiv.classList.add('hidden');
                }
            <?php endif; ?>

            document.getElementById('orderForm').addEventListener('submit', function(e) {
                if (!hiddenId.value || hiddenId.value === '') {
                    e.preventDefault();
                    errorDiv.classList.remove('hidden');
                    searchInput.focus();
                    alert('Silakan pilih pelanggan yang valid dari daftar.');
                }
            });
        });

        // ============== HANYA ANGKA UNTUK LEBAR & TINGGI ==============
        document.addEventListener('input', function(e) {
            if (e.target.classList.contains('angka-only')) {
                e.target.value = e.target.value.replace(/[^0-9.,]/g, '');
            }
        });

        // ============== HARGA DARI DATABASE ==============
        const priceList = {
            spanduk: {
                '1x1': <?= $priceData['spanduk']['1x1'] ?? 45000 ?>
            },
            sticker: {
                label: {
                    'A4': <?= $priceData['sticker']['label']['A4'] ?? 12000 ?>,
                    'A3': <?= $priceData['sticker']['label']['A3'] ?? 22000 ?>
                },
                decal: <?= $priceData['sticker']['decal'] ?? 1500 ?>
            },
            sablon: {
                'A3': <?= $priceData['sablon']['A3'] ?? 45000 ?>
            }
        };

        // ============== UPDATE HARGA ==============
        function updatePrice(row) {
            const category = row.querySelector('.product-category').value;
            const priceInput = row.querySelector('.price-input');
            const nameInput = row.querySelector('.product-name-input');
            const materialInput = row.querySelector('.material-input');

            let price = 0;
            let productName = '';
            let material = '-';

            if (category === 'spanduk') {
                const namaSpanduk = row.querySelector('.spanduk-nama').value || '';
                const lebar = parseFloat(row.querySelector('.spanduk-lebar').value) || 0;
                const tinggi = parseFloat(row.querySelector('.spanduk-tinggi').value) || 0;
                const ukuran = (lebar && tinggi) ? lebar + 'x' + tinggi : '';
                productName = 'Spanduk' + (namaSpanduk ? ' ' + namaSpanduk : '') + (ukuran ? ' ' + ukuran : '');
                productName = productName.trim();
                material = '-';
                const luas = lebar * tinggi;
                price = luas * (priceList.spanduk['1x1'] || 45000);
            } 
            else if (category === 'sticker') {
                const type = row.querySelector('.sticker-type').value;
                if (type === 'label') {
                    const size = row.querySelector('.sticker-label-size').value;
                    productName = 'Sticker Label ' + size;
                    material = '-';
                    price = priceList.sticker.label[size] || 0;
                } else if (type === 'decal') {
                    const panjang = parseFloat(row.querySelector('.decal-panjang').value) || 0;
                    const lebar = parseFloat(row.querySelector('.decal-lebar').value) || 0;
                    const luas = panjang * lebar;
                    productName = 'Sticker Decal ' + panjang + 'x' + lebar + ' cm';
                    material = '-';
                    price = luas * (priceList.sticker.decal || 1500);
                }
            } 
            else if (category === 'sablon') {
                const size = row.querySelector('.sablon-size').value;
                productName = 'Sablon A3';
                material = '-';
                price = priceList.sablon[size] || 0;
            } 
            else { // Lainnya
                productName = nameInput.value || 'Produk Lain';
                material = materialInput.value || '';
                price = parseFloat(priceInput.value) || 0;
            }

            if (category !== 'lainnya') {
                nameInput.value = productName;
                materialInput.value = material;
            }

            if (price > 0) {
                priceInput.value = price.toFixed(0);
            } else {
                if (category !== 'lainnya') {
                    priceInput.value = '0';
                }
            }

            const qty = parseInt(row.querySelector('.qty-input').value) || 1;
            const totalInput = row.querySelector('.item-total');
            const currentPrice = parseFloat(priceInput.value) || 0;
            totalInput.value = (qty * currentPrice).toFixed(0);

            recalculateTotal();
        }

        // ============== TOGGLE DYNAMIC FIELDS ==============
        function toggleDynamicFields(row) {
            const category = row.querySelector('.product-category').value;
            const nameInput = row.querySelector('.product-name-input');
            const materialInput = row.querySelector('.material-input');

            row.querySelectorAll('.dynamic-field').forEach(el => el.style.display = 'none');

            if (category === 'spanduk') {
                row.querySelector('.spanduk-field').style.display = 'block';
                nameInput.readOnly = true;
                materialInput.readOnly = false;
            } else if (category === 'sticker') {
                const type = row.querySelector('.sticker-type').value;
                row.querySelector('.sticker-field').style.display = 'block';
                if (type === 'label') {
                    row.querySelector('.sticker-label-field').style.display = 'block';
                    row.querySelector('.sticker-decal-field').style.display = 'none';
                } else if (type === 'decal') {
                    row.querySelector('.sticker-decal-field').style.display = 'block';
                    row.querySelector('.sticker-label-field').style.display = 'none';
                }
                nameInput.readOnly = true;
                materialInput.readOnly = false;
            } else if (category === 'sablon') {
                row.querySelector('.sablon-field').style.display = 'block';
                nameInput.readOnly = true;
                materialInput.readOnly = false;
            } else {
                row.querySelector('.manual-field').style.display = 'block';
                nameInput.readOnly = false;
                materialInput.readOnly = false;
                nameInput.value = '';
                materialInput.value = '';
            }

            updatePrice(row);
        }

        function recalculateTotal() {
            let subtotal = 0;
            document.querySelectorAll('.item-row').forEach(row => {
                const total = parseFloat(row.querySelector('.item-total').value) || 0;
                subtotal += total;
            });
            const discount = parseFloat(document.getElementById('discount').value) || 0;
            const grand = subtotal - discount;
            document.getElementById('subtotal').value = subtotal.toFixed(0);
            document.getElementById('grand_total').value = grand.toFixed(0);
        }

        function bindEvents(row) {
            row.querySelector('.product-category').addEventListener('change', function() {
                toggleDynamicFields(row);
            });

            row.querySelector('.sticker-type').addEventListener('change', function() {
                toggleDynamicFields(row);
            });

            const triggers = row.querySelectorAll('.price-trigger');
            triggers.forEach(el => {
                el.addEventListener('change', function() { updatePrice(row); });
                el.addEventListener('input', function() { updatePrice(row); });
            });

            row.querySelector('.qty-input').addEventListener('input', function() { updatePrice(row); });

            row.querySelector('.price-input').addEventListener('input', function() {
                const category = row.querySelector('.product-category').value;
                if (category === 'lainnya' || parseFloat(row.querySelector('.price-input').defaultValue) === 0) {
                    const qty = parseInt(row.querySelector('.qty-input').value) || 1;
                    const price = parseFloat(this.value) || 0;
                    row.querySelector('.item-total').value = (qty * price).toFixed(0);
                    recalculateTotal();
                }
            });

            row.querySelector('.remove-item').addEventListener('click', function() {
                if (document.querySelectorAll('.item-row').length > 1) {
                    row.remove();
                    recalculateTotal();
                } else {
                    alert('Minimal 1 item.');
                }
            });
        }

        document.querySelectorAll('.item-row').forEach(row => {
            toggleDynamicFields(row);
            bindEvents(row);
        });

        document.getElementById('add-item').addEventListener('click', function() {
            const container = document.getElementById('items-container');
            const template = document.getElementById('item-template').innerHTML;
            const wrapper = document.createElement('div');
            wrapper.className = 'item-row';
            wrapper.innerHTML = template;
            container.appendChild(wrapper);
            toggleDynamicFields(wrapper);
            bindEvents(wrapper);
        });

        document.getElementById('discount').addEventListener('input', function() {
            recalculateTotal();
        });

        recalculateTotal();
    </script>
</body>
</html>
